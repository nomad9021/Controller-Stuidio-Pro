<UserControl x:Class="ControllerStudioPro.Pages.TesterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ControllerStudioPro.Controls">
    <UserControl.Resources>
        <Style x:Key="Reading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <c:PadDiagram x:Name="Pad" />
                <TextBlock x:Name="Pressed" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="14"
                           Text="No buttons pressed" />
            </StackPanel>
        </Border>

        <UniformGrid x:Name="Cards" Columns="2">
            <!-- Sticks -->
            <Border Style="{StaticResource Card}" Margin="0,0,6,12">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Sticks" Style="{StaticResource CardTitle}" />
                        <Button Content="Clear Trails" HorizontalAlignment="Right" VerticalAlignment="Top" Click="ClearTrails_Click" />
                    </Grid>
                    <UniformGrid Columns="2" Margin="0,4,0,0">
                        <StackPanel>
                            <c:StickView x:Name="StickL" />
                            <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0"><Bold>Left</Bold> <Run x:Name="LVal" Text="–" /></TextBlock>
                        </StackPanel>
                        <StackPanel>
                            <c:StickView x:Name="StickR" />
                            <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0"><Bold>Right</Bold> <Run x:Name="RVal" Text="–" /></TextBlock>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                               Text="Circle the sticks slowly to draw their range. Let go to measure drift at rest." />
                </StackPanel>
            </Border>

            <!-- Triggers + lab -->
            <Border Style="{StaticResource Card}" Margin="6,0,0,12">
                <StackPanel>
                    <TextBlock Text="Triggers" Style="{StaticResource CardTitle}" />
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="L2" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Grid Grid.Column="1" x:Name="TrackL2" Height="12" VerticalAlignment="Center">
                            <Border CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Border x:Name="FillL2" CornerRadius="6" HorizontalAlignment="Left" Width="0"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Border x:Name="OutL2" Width="3" HorizontalAlignment="Left" Margin="0,-3"
                                    Background="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Grid>
                        <TextBlock Grid.Column="2" x:Name="PctL2" Text="0%" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,8,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="R2" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Grid Grid.Column="1" x:Name="TrackR2" Height="12" VerticalAlignment="Center">
                            <Border CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Border x:Name="FillR2" CornerRadius="6" HorizontalAlignment="Left" Width="0"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Border x:Name="OutR2" Width="3" HorizontalAlignment="Left" Margin="0,-3"
                                    Background="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Grid>
                        <TextBlock Grid.Column="2" x:Name="PctR2" Text="0%" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Bar: how far you're pulling. Line: what games receive." />

                    <TextBlock Text="Trigger Lab" Style="{StaticResource Strong}" Margin="0,16,0,8" />
                    <ListBox x:Name="LabSide" Style="{StaticResource Segmented}" SelectedIndex="1" Margin="0,0,0,6"
                             AutomationProperties.Name="Which trigger">
                        <ListBoxItem Tag="l2" Content="L2" />
                        <ListBoxItem Tag="r2" Content="R2" />
                        <ListBoxItem Tag="both" Content="Both" />
                    </ListBox>
                    <ListBox x:Name="LabKind" Style="{StaticResource Segmented}" SelectedIndex="0" Margin="0,0,0,6"
                             SelectionChanged="LabKind_SelectionChanged" AutomationProperties.Name="Effect">
                        <ListBoxItem Tag="smooth" Content="Smooth" />
                        <ListBoxItem Tag="zones" Content="Zones" />
                        <ListBoxItem Tag="click" Content="Click" />
                        <ListBoxItem Tag="vibrate" Content="Vibrate" />
                    </ListBox>
                    <c:SliderRow x:Name="LabStrength" Label="Strength" Minimum="1" Maximum="100" Format="pct" Value="60" />
                    <c:SliderRow x:Name="LabFreq" Label="Rate" Minimum="1" Maximum="120" Format="hz" Value="40" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Stop" Click="LabStop_Click" Margin="0,0,8,0" />
                        <Button Content="Apply for 10 s" Style="{DynamicResource AccentButtonStyle}" Click="LabGo_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Touchpad -->
            <Border Style="{StaticResource Card}" Margin="0,0,6,12">
                <StackPanel>
                    <TextBlock Text="Touchpad" Style="{StaticResource CardTitle}" />
                    <Viewbox Stretch="Uniform" MaxHeight="170">
                        <Border Width="384" Height="216" CornerRadius="10" BorderThickness="1"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <Canvas x:Name="TouchArea" ClipToBounds="True" />
                        </Border>
                    </Viewbox>
                    <TextBlock x:Name="TouchRead" Style="{StaticResource Hint}" Margin="0,8,0,0" Text="No touches" />
                </StackPanel>
            </Border>

            <!-- Motion -->
            <Border Style="{StaticResource Card}" Margin="6,0,0,12">
                <StackPanel>
                    <TextBlock Text="Motion" Style="{StaticResource CardTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="110" Height="110" ClipToBounds="True">
                            <Ellipse Fill="{DynamicResource ControlFillColorSecondaryBrush}"
                                     Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <Rectangle x:Name="Tilt" Width="70" Height="40" RadiusX="10" RadiusY="10"
                                       Fill="{DynamicResource AccentFillColorDefaultBrush}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="TiltScale" />
                                        <RotateTransform x:Name="TiltRotate" />
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Tilt" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Name="TiltRead" Style="{StaticResource Reading}" Text="–" />
                            <TextBlock Grid.Row="1" Text="Gyro" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="GyroRead" Style="{StaticResource Reading}" Text="–" />
                            <TextBlock Grid.Row="2" Text="Accel" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AccelRead" Style="{StaticResource Reading}" Text="–" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Rumble -->
            <Border Style="{StaticResource Card}" Margin="0,0,6,12">
                <StackPanel>
                    <TextBlock Text="Rumble" Style="{StaticResource CardTitle}" />
                    <c:SliderRow x:Name="RumStrong" Label="Heavy motor" Minimum="0" Maximum="100" Step="5" Format="pct" Value="80" />
                    <c:SliderRow x:Name="RumWeak" Label="Light motor" Minimum="0" Maximum="100" Step="5" Format="pct" Value="40" />
                    <Button Content="Rumble for 1 s" HorizontalAlignment="Right" Margin="0,8,0,0" Click="Rumble_Click" />
                </StackPanel>
            </Border>

            <!-- Connection -->
            <Border Style="{StaticResource Card}" Margin="6,0,0,12">
                <StackPanel>
                    <TextBlock Text="Connection" Style="{StaticResource CardTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Model" Style="{StaticResource Hint}" />
                        <TextBlock Grid.Column="1" x:Name="InfoModel" Margin="0,2" Text="–" />
                        <TextBlock Grid.Row="1" Text="Connection" Style="{StaticResource Hint}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InfoConn" Margin="0,2" Text="–" />
                        <TextBlock Grid.Row="2" Text="Address" Style="{StaticResource Hint}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="InfoAddr" Margin="0,2" Text="–" />
                        <TextBlock Grid.Row="3" Text="Report rate" Style="{StaticResource Hint}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="InfoRate" Margin="0,2" Text="–" />
                        <TextBlock Grid.Row="4" Text="Battery" Style="{StaticResource Hint}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="InfoBatt" Margin="0,2" Text="–" />
                    </Grid>
                </StackPanel>
            </Border>
        </UniformGrid>
    </StackPanel>
</UserControl>
