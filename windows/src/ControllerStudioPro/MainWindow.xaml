<Window x:Class="ControllerStudioPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controller Studio Pro" Icon="app.ico"
        Width="1240" Height="840" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="12,8,12,4" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DeviceIcon" Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="22" Margin="0,0,12,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="DeviceName" Style="{StaticResource Strong}" Text="No controller" />
                        <TextBlock x:Name="DeviceMeta" Style="{StaticResource Hint}" Text="Press the PS button to connect" />
                    </StackPanel>
                    <StackPanel x:Name="Battery" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="Collapsed" ToolTip="Battery">
                        <TextBlock x:Name="BatteryText" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Border Width="26" Height="13" CornerRadius="3" BorderThickness="1.2"
                                BorderBrush="{DynamicResource TextFillColorSecondaryBrush}" Padding="1.5">
                            <Border x:Name="BatteryFill" HorizontalAlignment="Left" CornerRadius="1.5"
                                    Background="{DynamicResource TextFillColorPrimaryBrush}" Width="20" />
                        </Border>
                        <Border Width="2" Height="6" Background="{DynamicResource TextFillColorSecondaryBrush}" CornerRadius="0,1,1,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,0,4,12">
                    <TextBlock Text="Presets" Style="{StaticResource Group}" />
                    <ListView x:Name="PresetList" BorderThickness="0" Background="Transparent"
                              SelectionChanged="PresetList_SelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="Presets">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="34" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Use This Preset" Click="Ctx_Use" />
                                            <MenuItem Header="Duplicate" Click="Ctx_Duplicate" />
                                            <Separator />
                                            <MenuItem Header="Delete Preset…" Click="Ctx_Delete" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Ellipse Width="12" Height="12" Margin="2,0,12,0" VerticalAlignment="Center"
                                             Fill="{Binding Lightbar, Converter={StaticResource HexBrush}}"
                                             Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" Style="{StaticResource Pill}" Padding="7,1" Margin="6,0,0,0"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            Visibility="{Binding IsActive, Converter={StaticResource Visible}}">
                                        <TextBlock Text="In Use" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                    <Button Grid.Column="3" Click="DeleteItem_Click" Padding="5" Margin="4,0,0,0"
                                            Background="Transparent" BorderThickness="0" ToolTip="Delete preset"
                                            AutomationProperties.Name="Delete preset">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Visibility" Value="Hidden" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button x:Name="RestoreButton" Click="Restore_Click" Margin="8,4,8,0" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock x:Name="RestoreText" Text="Restore built-in presets" />
                        </StackPanel>
                    </Button>
                    <Button Click="NewPreset_Click" Margin="8,4,8,0" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="New Preset from Selected" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="Device" Style="{StaticResource Group}" />
                    <ListView x:Name="PageList" BorderThickness="0" Background="Transparent"
                              SelectionChanged="PageList_SelectionChanged" AutomationProperties.Name="Device pages">
                        <ListViewItem Tag="lighting">
                            <StackPanel Orientation="Horizontal" Height="34">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE82F;" Margin="2,0,12,0" />
                                <TextBlock Text="Lighting" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="output">
                            <StackPanel Orientation="Horizontal" Height="34">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" Margin="2,0,12,0" />
                                <TextBlock Text="Output" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="tester">
                            <StackPanel Orientation="Horizontal" Height="34">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Margin="2,0,12,0" />
                                <TextBlock Text="Controller Tester" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListViewItem>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ============ Content ============ -->
        <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="28,20,28,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Style="{DynamicResource TitleTextBlockStyle}" FontSize="26"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="Controller Studio Pro" />
                        <TextBlock x:Name="PageSubtitle" Style="{StaticResource Hint}" FontSize="13" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <StackPanel x:Name="PresetActions" Orientation="Horizontal">
                            <StackPanel x:Name="InUse" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="14" Margin="0,0,6,0"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="In Use" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                            <Button x:Name="UseButton" Content="Use This Preset" Style="{DynamicResource AccentButtonStyle}"
                                    Click="Use_Click" Margin="0,0,8,0" />
                            <Button x:Name="MoreButton" Click="More_Click" ToolTip="More" AutomationProperties.Name="More actions"
                                    Padding="10,7">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE712;" FontSize="14" />
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="MoreMenu">
                                        <MenuItem Header="Rename…" Click="Rename_Click">
                                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8AC;" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Duplicate" Click="Duplicate_Click">
                                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="ResetItem" Header="Reset to Defaults" Click="Reset_Click">
                                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE777;" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem x:Name="DeleteItem" Header="Delete Preset…" Click="Delete_Click">
                                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" /></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Border Width="1" Margin="16,4" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        </StackPanel>
                        <CheckBox x:Name="EffectsSwitch" Style="{StaticResource ToggleSwitch}" Content="Trigger Effects"
                                  Click="EffectsSwitch_Click"
                                  ToolTip="Hold L3 + R3 on the controller for one second to toggle" />
                    </StackPanel>
                </Grid>

                <Border x:Name="Banner" Grid.Row="1" Margin="28,0,28,10" Padding="14,10" CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Margin="0,0,12,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock x:Name="BannerText" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="Scroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ContentControl x:Name="PageHost" Margin="28,4,28,28" Focusable="False" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
