<Window x:Class="ControllerStudioPro.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename Preset" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <StackPanel Margin="24,20,24,24">
        <TextBlock Text="Rename Preset" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
        <TextBlock Text="Name" Margin="0,0,0,6" />
        <TextBox x:Name="NameBox" MaxLength="40" />
        <TextBlock Text="Description" Margin="0,14,0,6" />
        <TextBox x:Name="DescriptionBox" MaxLength="140" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Save" IsDefault="True" Click="Save_Click" MinWidth="96"
                    Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0" />
            <Button Content="Cancel" IsCancel="True" MinWidth="96" />
        </StackPanel>
    </StackPanel>
</Window>
